<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Android 15 erzwingt bei targetSdk 35 Edge-to-Edge. Die WebView wuerde dann unter Status- und
        Navigationsleiste liegen, und env(safe-area-inset-*) meldet in der WebView nichts zurueck.
        Solange die App die Insets nicht selbst verteilt, bleibt das alte Verhalten aktiv.
    -->
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/background</item>
        <item name="android:colorPrimaryDark">@color/background</item>
        <item name="android:colorAccent">@color/aqua</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowSplashScreenBackground">@color/background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
